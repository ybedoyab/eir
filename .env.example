# Shared team config for GCP project eir-ata.
# Copy to `.env` in the repo root. Do not add package-level .env files.
# `.env` is gitignored — never commit API keys.

ENVIRONMENT=development

GOOGLE_CLOUD_PROJECT=eir-ata
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini API key mode — no gcloud login required.
# Put the team GOOGLE_API_KEY in local `.env` (not in this file).
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_API_KEY=

FHIR_PROJECT=eir-ata
FHIR_LOCATION=us-central1
FHIR_DATASET=eir
FHIR_STORE=fhir-r4

PUBSUB_TOPIC=eir-recovery-events
PUBSUB_SUBSCRIPTION=eir-recovery-events-worker

# Adapter switches. Tests force in-memory regardless of these values.
# EVENT_BUS=pubsub mirrors events to Pub/Sub; local handlers still run in-process.
# Do not set WORKFLOW_SUBSCRIBER=pubsub unless a worker is running with --handle.
EVENT_BUS=memory
EPISODE_STORE=file
FHIR_MODE=local
FHIR_FALLBACK=true
OUTREACH_LLM=false
ADK_RUNNER_MODE=direct
WORKFLOW_SUBSCRIBER=local
DATA_DIR=data

VOICE_PROVIDER=mock

NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated browser origins allowed by the API (production deploy sets this).
# CORS_ORIGINS=http://localhost:3000;https://eir-ui-658898892127.us-central1.run.app
