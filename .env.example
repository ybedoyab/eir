# Shared team config for GCP project eir-ata.
# Copy to `.env` in the repo root. Do not add package-level .env files.
# `.env` is gitignored — never commit API keys.

ENVIRONMENT=development

GOOGLE_CLOUD_PROJECT=eir-ata
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini API key mode — no gcloud login required.
# Put the team GOOGLE_API_KEY in local `.env` (not in this file).
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=

FHIR_PROJECT=eir-ata
FHIR_LOCATION=us-central1
FHIR_DATASET=eir
FHIR_STORE=fhir-r4

PUBSUB_TOPIC=eir-recovery-events

VOICE_PROVIDER=mock

NEXT_PUBLIC_API_URL=http://localhost:8000
